// ============================================
// ELECTRA MAN — Firestore Security Rules (v3, multiple admins supported)
// ============================================
// BEFORE PASTING: replace the UIDs inside the isAdmin() list below with
// the real UIDs of everyone who should have admin access (get each UID
// from Firebase console -> Authentication -> Users, after creating their
// account — see steps at the bottom).
//
// Each person should have THEIR OWN email/password account (don't share
// one login). To change a password later: Authentication -> Users ->
// (⋮ menu next to that user) -> "Reset password" — this emails a reset
// link to that account's real email address.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "9XbspzjzugaiAXkXJU43akPVe8y1",
        "ADMIN_UID_2_HERE"
        // add more "UID_HERE" lines separated by commas if needed
      ];
    }

    // ---- Experts: publicly readable (customers browse them) ----
    match /experts/{expertId} {
      allow read: if true;
      // Anyone can CREATE their own gig — but only after their application
      // was approved by the admin (enforced in the app flow). Editing an
      // EXISTING expert (e.g. changing verified status) is admin-only.
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ---- Applications: new experts apply, admin approves/rejects ----
    match /applications/{appId} {
      allow read: if true;
      allow create: if true;
      allow update: if
        isAdmin()
        // OR the applicant marking their own gig as published —
        // only allowed once status is ALREADY "approved" (set by admin),
        // and only these two fields may change.
        || (
          resource.data.status == "approved" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["gigPublished", "expertId"])
        );
      allow delete: if isAdmin();
    }

    // ---- Bookings: customer creates & later releases escrow, expert can
    //      touch jobStatus / completionOtp / escrowReleased individually,
    //      admin confirms payment ----
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if
        isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["jobStatus"])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["completionOtp"])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["escrowReleased"]);
      allow delete: if isAdmin();
    }

    // ---- Token Fees: small upfront lock paid before chat unlocks.
    //      Anyone can submit one; only admin verifies/rejects it. ----
    match /tokenFees/{tokenId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ---- Chats + messages: open for now (no customer/expert auth yet) ----
    match /chats/{chatId} {
      allow read: if true;
      allow write: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}

// ============================================
// HOW TO SET UP ADMIN ACCOUNTS (one-time per person):
// ============================================
// 1. Firebase console -> "Build" -> "Authentication"
// 2. "Get started" (if first time) -> "Sign-in method" tab
// 3. Enable "Email/Password" provider -> Save
// 4. Go to "Users" tab -> "Add user"
// 5. Enter their real email + a password -> Add user
//    (repeat for each person who needs admin access — e.g. yourself AND
//    the real owner, each with their OWN email)
// 6. Copy each person's "User UID" shown in the Users list
// 7. Paste those UIDs into the isAdmin() list above (replace
//    ADMIN_UID_1_HERE, ADMIN_UID_2_HERE, add more lines if needed)
// 8. Firestore Database -> "Rules" tab -> paste this whole file -> Publish
// 9. To change someone's password later: Users tab -> (⋮) next to their
//    row -> "Reset password" -> Firebase emails them a reset link.
//    You never need to know or share their password directly.
